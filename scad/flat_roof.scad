// --- Assembly ---
wall_cream = [0.88, 0.82, 0.60];  // warm cream-yellow (match main house)
roof_teal = [0.10, 0.35, 0.33];  // dark teal-green metal (match main house)
color(wall_cream) union() {
  // Lower walls (0 to 20", doors O3 and O6 only)
  linear_extrude(height = lower_height)
    wall_shell(t_lower_O3_O3, half_t);
  // Middle walls (20" to 80", all openings)
  translate([0, 0, lower_height])
    linear_extrude(height = middle_height)
      wall_shell(t_O8_O2, half_t);
  translate([0, 0, lower_height])
    linear_extrude(height = middle_height)
      wall_shell(t_O2_O3, half_t);
  translate([0, 0, lower_height])
    linear_extrude(height = middle_height)
      wall_shell(t_O3_O4, half_t);
  translate([0, 0, lower_height])
    linear_extrude(height = middle_height)
      wall_shell(t_O4_O8, half_t);
  // Upper wall (80" to 112", O4 only)
  translate([0, 0, upper_base])
    linear_extrude(height = upper_height)
      wall_shell(t_full_O4, half_t);
}
// Wedge roof slab (18"-25.4", 1/4"/ft slope N)
color(roof_teal) {
  translate([0, 0, upper_base + upper_height])
    render() intersection() {
      linear_extrude(height = max_roof_thick + 0.1)
        polygon(points = shell_pts(roof_outline, 0));
      multmatrix([[1,0,0,0], [0,1,0,0],
                  [0, roof_slope, 1, roof_z_base], [0,0,0,1]])
        translate([-25, -20, -25])
          cube([50, 40, 25]);
    }
  // Standing seam ribs (16" o.c., 1" wide, 1.5" tall)
  translate([0, 0, upper_base + upper_height])
    for (x = [-57.836964 : seam_spacing : -23.482796])
      intersection() {
        multmatrix([[1,0,0,0], [0,1,0,0],
                    [0, roof_slope, 1, roof_z_base], [0,0,0,1]])
          translate([x - seam_w/2, -7.220979, 0])
            cube([seam_w, 29.648859, seam_h]);
        linear_extrude(height = max_roof_thick + seam_h + 0.01)
          polygon(points = shell_pts(roof_outline, 0));
      }
}
