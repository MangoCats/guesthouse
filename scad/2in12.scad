  // Upper wall (80" to sloped roof underside, O4 only)
  render() intersection() {
    translate([0, 0, upper_base])
      linear_extrude(height = max_upper_h)
        wall_shell(t_full_O4, half_t);
    multmatrix(roof_shear)
      translate([-25, -20, -20])
        cube([50, 40, 20]);
  }
}
// Sloped roof slab (18", 2:12 slope N, 7'6" at F18-F1)
color(roof_teal) {
  multmatrix(roof_shear)
    linear_extrude(height = roof_thick)
      polygon(points = shell_pts(roof_outline, 0));
  // Standing seam ribs (16" o.c., 1" wide, 1.5" tall)
  multmatrix(roof_shear)
    for (x = [-18.300594 : seam_spacing : 20.687450])
      intersection() {
        translate([x - seam_w/2, -10.590897, roof_thick])
          cube([seam_w, 28.590897, seam_h]);
        linear_extrude(height = roof_thick + seam_h + 0.01)
          polygon(points = shell_pts(roof_outline, 0));
      }
}
