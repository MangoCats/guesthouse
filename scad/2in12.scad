// Lower walls:  0 to 20" (1'8") — doors O3, O6 only
// Middle walls: 20" to 80" (5'0") — all openings
// Upper wall:   80" to sloped roof underside (O4 only)
// Roof: 18" slab, 2:12 slope N, 7'6" at F18-F19
// Construction: 2" outer shell / 4" air gap / 2" inner shell
// 2 lower + 11 middle + 1 upper wall sections
// Units: feet
// Generated by scad/gen_2in12.py

// --- Helper functions ---
// Segment types: [0, x1, y1, x2, y2] = line
//                 [1, cx, cy, r, a1, a2] = arc (degrees)

function arc_n(sweep) = max(4, round(abs(sweep) / 3));

function line_pts(seg, d) =
  let(dx = seg[3]-seg[1], dy = seg[4]-seg[2],
      len = sqrt(dx*dx + dy*dy),
      nx = -dy/len, ny = dx/len)
  [[seg[1]+d*nx, seg[2]+d*ny], [seg[3]+d*nx, seg[4]+d*ny]];

function arc_off_pts(seg, d) =
  let(cx = seg[1], cy = seg[2], r = seg[3],
      a1 = seg[4], a2 = seg[5],
      r_off = a2 > a1 ? r - d : r + d,
      n = arc_n(a2 - a1))
  [for (i=[0:n]) [cx + r_off*cos(a1 + i*(a2-a1)/n),
                   cy + r_off*sin(a1 + i*(a2-a1)/n)]];

function seg_pts(seg, d) =
  seg[0] == 0 ? line_pts(seg, d) : arc_off_pts(seg, d);

function tail(v) = len(v) > 1
  ? [for (i=[1:len(v)-1]) v[i]] : [];

function shell_pts(path, d) =
  [for (i=[0:len(path)-1]) each
    (i == 0 ? seg_pts(path[i], d) : tail(seg_pts(path[i], d)))];

module wall_shell(path, d) {
  ext = shell_pts(path, -d);
  gap = shell_pts(path, d);
  n_ext = len(ext);
  polygon(
    points = concat(ext, gap),
    paths = [
      [for (i=[0:n_ext-1]) i],
      [for (i=[0:len(gap)-1]) n_ext + i]
    ]
  );
}

